1d:["$","section","0",{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"¿Cómo se calcula el índice PaFi?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"El índice PaFi se calcula dividiendo la presión parcial de oxígeno en sangre arterial (PaO₂, obtenida de una gasometría arterial) entre la fracción inspirada de oxígeno (FiO₂, expresada como decimal): PaFi = PaO₂ ÷ FiO₂. Por ejemplo, con una PaO₂ de 90 mmHg y una FiO₂ del 40% (0.4), el índice PaFi es 90 ÷ 0.4 = 225."}]]}]
1e:["$","section","1",{"className":"mb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-gray-900 mb-3","children":"¿Para qué se usa el índice PaFi?"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"El índice PaFi es uno de los criterios usados en la definición de Berlín del Síndrome de Dificultad Respiratoria Aguda (SDRA), donde valores más bajos indican una alteración más severa del intercambio de gases. Sin embargo, el diagnóstico de SDRA requiere además otros criterios clínicos y radiológicos, no solo el valor de PaFi de forma aislada."}]]}]
1f:["$","$L21",null,{"faqs":[{"question":"¿Cuál es la fórmula del índice PaFi?","answer":"PaFi = PaO₂ ÷ FiO₂, donde la FiO₂ se expresa como fracción decimal (por ejemplo, 21% de aire ambiente equivale a 0.21)."},{"question":"¿Qué significa un PaFi bajo?","answer":"Un valor bajo de PaFi indica una alteración más severa en el intercambio de oxígeno a nivel pulmonar. Como referencia general: más de 400 se considera normal, y valores progresivamente menores (300, 200, 100) reflejan alteraciones cada vez más severas."},{"question":"¿El PaFi por sí solo diagnostica el SDRA?","answer":"No. El PaFi es uno de varios criterios de la definición de Berlín para el SDRA, que también requiere inicio agudo de los síntomas, opacidades bilaterales en la radiografía o TAC de tórax, un nivel mínimo de PEEP, y la exclusión de insuficiencia cardíaca como causa principal."},{"question":"¿Es gratis esta calculadora de PaFi?","answer":"Sí, es completamente gratuita, sin límite de usos y sin necesidad de registro."}]}]
